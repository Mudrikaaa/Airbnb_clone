# Local default creates backend/airbnb.db.
# Production (Railway, volume mounted at /data): sqlite:////data/airbnb.db  (four slashes = absolute path)
DATABASE_URL=sqlite:///./airbnb.db

# CORS: comma-separated list of exact frontend origins (scheme + host, no trailing slash, no path).
# Production example (keep localhost for local dev against the deployed API if you like):
#   FRONTEND_ORIGIN=http://localhost:3000,https://airbnb-clone-xk2g.vercel.app
# Vercel preview deployments have their own URLs; add them here if you want to test previews.
FRONTEND_ORIGIN=http://localhost:3000
